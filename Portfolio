<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daniel Ayala Vilchis | Mechanical Engineering</title>
<meta name="description" content="Portfolio of Daniel Sebastián Ayala Vilchis, Mechanical Engineering student at UTEP — CAD design, manufacturing, and underwater robotics.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f6f8fb;
    --paper:#ffffff;
    --ink:#0f1b2d;
    --muted:#55637a;
    --line:#d9e1ec;
    --grid:rgba(30,80,160,.07);
    --accent:#e8590c;
    --accent-soft:#fff1e8;
    --blue:#1d4ed8;
    --mono:'IBM Plex Mono', ui-monospace, monospace;
    --sans:'Inter', system-ui, -apple-system, sans-serif;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#0b1220;
      --paper:#111a2b;
      --ink:#e8eef8;
      --muted:#9aa8bf;
      --line:#22314a;
      --grid:rgba(120,170,255,.06);
      --accent:#ff8a3d;
      --accent-soft:#2a1a10;
      --blue:#7aa7ff;
    }
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:var(--sans);
    color:var(--ink);
    background-color:var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:28px 28px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit}
  .wrap{max-width:1040px;margin:0 auto;padding:0 20px}

  /* NAV */
  nav{
    position:sticky;top:0;z-index:10;
    background:color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex;justify-content:space-between;align-items:center;height:60px}
  .logo{font-family:var(--mono);font-weight:500;font-size:15px;text-decoration:none}
  .logo span{color:var(--accent)}
  .links{display:flex;gap:22px}
  .links a{text-decoration:none;font-size:14px;color:var(--muted);font-weight:500}
  .links a:hover{color:var(--ink)}
  @media (max-width:640px){.links{display:none}}

  /* HERO */
  header.hero{padding:88px 0 64px}
  .tag{
    font-family:var(--mono);font-size:13px;color:var(--accent);
    letter-spacing:.04em;margin-bottom:18px;
  }
  h1{
    font-size:clamp(40px,7vw,72px);
    line-height:1.02;letter-spacing:-.035em;font-weight:800;
  }
  h1 .light{color:var(--muted);font-weight:700}
  .lede{max-width:620px;margin-top:22px;font-size:18px;color:var(--muted)}
  .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:12px 20px;border-radius:8px;
    font-weight:600;font-size:15px;text-decoration:none;
    border:1.5px solid var(--ink);transition:transform .15s ease;
  }
  .btn:hover{transform:translateY(-2px)}
  .btn.primary{background:var(--ink);color:var(--bg)}
  .stats{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    margin-top:56px;background:var(--line);
    border:1px solid var(--line);border-radius:12px;overflow:hidden;
  }
  .stat{background:var(--paper);padding:20px 22px}
  .stat b{display:block;font-size:26px;letter-spacing:-.02em}
  .stat small{font-family:var(--mono);font-size:12px;color:var(--muted)}
  @media (max-width:640px){.stats{grid-template-columns:1fr}}

  /* SECTIONS */
  section{padding:56px 0}
  .sec-head{display:flex;align-items:baseline;gap:14px;margin-bottom:28px}
  .sec-num{font-family:var(--mono);font-size:13px;color:var(--accent)}
  h2{font-size:28px;letter-spacing:-.02em}

  /* PROJECTS */
  .project{
    display:grid;grid-template-columns:1.05fr 1fr;gap:0;
    background:var(--paper);border:1px solid var(--line);
    border-radius:14px;overflow:hidden;margin-bottom:24px;
  }
  .project:nth-child(even) .media{order:2}
  @media (max-width:760px){
    .project{grid-template-columns:1fr}
    .project:nth-child(even) .media{order:0}
  }
  .media{
    position:relative;min-height:260px;
    background:
      repeating-linear-gradient(45deg, transparent 0 10px, var(--grid) 10px 11px),
      var(--accent-soft);
    display:flex;align-items:center;justify-content:center;
  }
  .media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .placeholder{
    font-family:var(--mono);font-size:12px;color:var(--muted);
    border:1.5px dashed var(--muted);padding:10px 14px;border-radius:6px;
  }
  .body{padding:28px}
  .meta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;
    font-family:var(--mono);font-size:12px;color:var(--muted);margin-bottom:8px}
  .badge{color:var(--accent)}
  .body h3{font-size:22px;letter-spacing:-.01em;margin-bottom:12px}
  .body ul{list-style:none;display:grid;gap:9px}
  .body li{position:relative;padding-left:18px;font-size:15px;color:var(--muted)}
  .body li::before{content:"";position:absolute;left:0;top:10px;width:7px;height:2px;background:var(--accent)}
  .body li strong{color:var(--ink);font-weight:600}
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}
  .chip{
    font-family:var(--mono);font-size:11.5px;
    padding:4px 9px;border-radius:999px;
    border:1px solid var(--line);color:var(--muted);background:var(--bg);
  }

  /* SKILLS */
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media (max-width:760px){.grid3{grid-template-columns:1fr}}
  .card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:22px}
  .card h4{font-family:var(--mono);font-size:12px;font-weight:500;color:var(--accent);
    text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}
  .card p{font-size:15px;color:var(--muted)}

  /* EXPERIENCE */
  .timeline{border-left:2px solid var(--line);margin-left:6px}
  .item{position:relative;padding:0 0 30px 26px}
  .item::before{content:"";position:absolute;left:-7px;top:6px;width:12px;height:12px;
    border-radius:50%;background:var(--bg);border:2px solid var(--accent)}
  .item h3{font-size:18px}
  .item .where{font-size:14px;color:var(--muted)}
  .item .when{font-family:var(--mono);font-size:12px;color:var(--muted);margin-bottom:6px}
  .item ul{margin-top:8px;padding-left:18px;color:var(--muted);font-size:15px;display:grid;gap:4px}

  /* HONORS */
  .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media (max-width:760px){.two{grid-template-columns:1fr}}
  .card ul{list-style:none;display:grid;gap:10px}
  .card li{font-size:15px;color:var(--muted);padding-bottom:10px;border-bottom:1px dashed var(--line)}
  .card li:last-child{border-bottom:none;padding-bottom:0}
  .card li b{color:var(--ink);font-weight:600}

  /* CONTACT */
  .contact{
    background:var(--ink);color:var(--bg);border-radius:16px;
    padding:48px 32px;text-align:center;margin:24px 0 64px;
  }
  .contact h2{font-size:clamp(26px,4vw,36px);margin-bottom:10px}
  .contact p{opacity:.75;margin-bottom:26px}
  .contact .btn{border-color:var(--bg)}
  .contact .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .contact .cta{justify-content:center}
  footer{text-align:center;font-family:var(--mono);font-size:12px;color:var(--muted);padding:0 0 40px}

  .reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease, transform .6s ease}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}
</style>
</head>
